# ============================================================================
#  Area Incident Tracker - Desktop (Flutter / Windows)
#  See README.md for what each path is.
#  NOTE: pubspec.lock, windows/runner/** and .metadata are intentionally
#        COMMITTED - do not add them here.
# ============================================================================

# --- Operating system noise -------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- OneDrive / cloud-sync placeholders -------------------------------------
# The repo lives in a OneDrive folder; these are sync artefacts, not sources.
*.tmp
~$*
*~.tmp
(~$*)

# --- Editors / IDEs ---------------------------------------------------------
# IntelliJ / Android Studio / Rider
.idea/
*.iml
*.ipr
*.iws
out/
.atom/
.build/
.buildlog/
.history
.swiftpm/
.svn/
migrate_working_dir/

# Visual Studio / VS Code - local launch & task settings only
.vs/
.vscode/
!.vscode/extensions.json

# Sublime / Vim / JetBrains scratch
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Flutter / Dart / Pub ---------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
doc/api/
**/doc/api/
pubspec_overrides.yaml
.flutter-plugins-dependencies
**/ios/Flutter/.last_build_id

# Generated package config / kernel snapshots
*.dill
*.stamp

# --- Symbolication / obfuscation -------------------------------------------
app.*.symbols
app.*.map.json
*.jks
*.keystore

# --- Windows desktop build output ------------------------------------------
# (windows/flutter/ephemeral/ is already ignored by windows/.gitignore)
x64/
x86/
windows/flutter/ephemeral/
*.suo
*.user
*.userosscache
*.sln
*.sln.docstates
*.[Cc]ache
!*.[Cc]ache/
*.aps
*.ncb
*.opendb
*.VC.db
*.VC.opendb
*.db-shm
*.db-wal
*.sdf
*.opensdf
*.bak
*.obj
*.idb
*.ilk
*.iobj
*.ipch/
*.exp
*.pdb
*.tlog
*.lastbuildstate
*.log
*.manifest.bak

# --- Test / code generation coverage ----------------------------------------
**/coverage/
**/test/**/golden_failures/
lcov.info
coverage/lcov.info

# --- Secrets ----------------------------------------------------------------
.env
.env.*
*.pem
*.key
!**/android/app/src/main/res/**/*

# --- Widget Preview ---------------------------------------------------------
.widget_preview/

# --- Notes ------------------------------------------------------------------
# .metadata          - Flutter tool version stamp, commit it
# pubspec.lock       - app dependency lock, commit it
# windows/CMakeLists.txt, windows/runner/** - generated once by setup_windows.bat, commit it
# windows/flutter/generated_plugin_registrant.*, generated_plugins.cmake - generated by pub get, commit it